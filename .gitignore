# Package files (MUST come before the wrapper !exceptions below)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Keep the Gradle wrapper committable (last match wins, so these go AFTER *.jar)
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
!gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.properties

